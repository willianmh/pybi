model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 0

queryGroup Facts

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Functions and parameters'

	annotation PBI_QueryGroupOrder = 2

annotation PBI_QueryOrder = ["Accounts","Dates","Opportunities","Partners","Products","SalesStages","Sales","fxResultGenerator","fxDateGenerator","Start date","Language code"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DaxQueryView_Desktop","Copilot","CopilotMeasureDescriptions","DevMode"]

ref table Accounts
ref table Opportunities
ref table Partners
ref table Products
ref table SalesStages
ref table Sales
ref table Dates

ref cultureInfo en-US

