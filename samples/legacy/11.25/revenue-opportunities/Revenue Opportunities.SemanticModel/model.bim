    "expressions": [
      {
        "name": "fxResultGenerator",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ],
        "expression": [
          "(lower as number, upper as number) as number =>",
          "let",
          "    Source =  Number.RandomBetween(lower, upper),",
          "    IntOnly = Int64.From(Source)",
          "in",
          "    IntOnly"
        ],
        "kind": "m",
        "lineageTag": "2bacb60c-c75b-4ff0-ad81-61d3153a1c9b",
        "queryGroup": "Functions and parameters"
      },
      {
        "name": "fxDateGenerator",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ],
        "expression": [
          "(StartDate as date, EndDate as date, optional Culture as nullable text) as table =>",
          "    let",
          "        DayCount =",
          "            Duration.TotalDays(EndDate - StartDate)",
          "            + 1,",
          "        Source =",
          "            List.Dates(",
          "                StartDate,",
          "                DayCount,",
          "                #duration(1, 0, 0, 0)",
          "            ),",
          "        TableFromList =",
          "            Table.FromList(",
          "                Source,",
          "                Splitter.SplitByNothing(),",
          "                type table [Date = date]",
          "            ),",
          "        InsertYear =",
          "            Table.AddColumn(",
          "                TableFromList,",
          "                \"Year\",",
          "                each Date.Year([Date]),",
          "                Int64.Type",
          "            ),",
          "        InsertMonth =",
          "            Table.AddColumn(",
          "                InsertYear,",
          "                \"Month (Sort Order)\",",
          "                each Date.Month([Date]),",
          "                Int8.Type",
          "            ),",
          "        InsertMonthName =",
          "            Table.AddColumn(",
          "                InsertMonth,",
          "                \"Month\",",
          "                each Date.ToText([Date], \"MMMM\", Culture),",
          "                type text",
          "            ),",
          "        InsertDay =",
          "            Table.AddColumn(",
          "                InsertMonthName,",
          "                \"Day\",",
          "                each Date.Day([Date]),",
          "                Int8.Type",
          "            ),",
          "        InsertDayWeek =",
          "            Table.AddColumn(",
          "                InsertDay,",
          "                \"Day (Sort Order)\",",
          "                each Date.DayOfWeek([Date], Day.Monday) + 1,",
          "                Int8.Type",
          "            ),",
          "        InsertDayName =",
          "            Table.AddColumn(",
          "                InsertDayWeek,",
          "                \"Day Of Week Name\",",
          "                each Date.ToText([Date], \"dddd\", Culture),",
          "                type text",
          "            ),",
          "        InsertWeekofYear =",
          "            Table.AddColumn(",
          "                InsertDayName,",
          "                \"Week of Year\",",
          "                each Date.WeekOfYear([Date]),",
          "                Int8.Type",
          "            )",
          "    in",
          "        InsertWeekofYear"
        ],
        "kind": "m",
        "lineageTag": "ef662261-7ea3-4f71-b99b-237c08b05fba",
        "queryGroup": "Functions and parameters"
      },
