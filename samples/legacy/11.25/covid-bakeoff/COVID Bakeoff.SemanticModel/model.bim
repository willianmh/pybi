                "value": "{\"Version\":0,\"Sources\":[{\"Name\":\"g\",\"Entity\":\"Govt Measures\"}],\"GroupedColumns\":[{\"Column\":{\"Expression\":{\"SourceRef\":{\"Source\":\"g\"}},\"Property\":\"NON_COMPLIANCE\"}}],\"GroupItems\":[{\"DisplayName\":\"(Blank)\",\"BlankDefaultPlaceholder\":true},{\"DisplayName\":\"Arrest\",\"Expression\":{\"In\":{\"Expressions\":[{\"Column\":{\"Expression\":{\"SourceRef\":{\"Source\":\"g\"}},\"Property\":\"NON_COMPLIANCE\"}}],\"Values\":[[{\"Literal\":{\"Value\":\"'Arrest/Detention'\"}}],[{\"Literal\":{\"Value\":\"'Up to detention'\"}}]]}}},{\"DisplayName\":\"Deportation/entry refused\",\"Expression\":{\"In\":{\"Expressions\":[{\"Column\":{\"Expression\":{\"SourceRef\":{\"Source\":\"g\"}},\"Property\":\"NON_COMPLIANCE\"}}],\"Values\":[[{\"Literal\":{\"Value\":\"'Deportation'\"}}],[{\"Literal\":{\"Value\":\"'Refusal to enter the country'\"}}]]}}},{\"DisplayName\":\"Fines\",\"Expression\":{\"In\":{\"Expressions\":[{\"Column\":{\"Expression\":{\"SourceRef\":{\"Source\":\"g\"}},\"Property\":\"NON_COMPLIANCE\"}}],\"Values\":[[{\"Literal\":{\"Value\":\"'Fines'\"}}]]}}},{\"DisplayName\":\"Legal\",\"Expression\":{\"In\":{\"Expressions\":[{\"Column\":{\"Expression\":{\"SourceRef\":{\"Source\":\"g\"}},\"Property\":\"NON_COMPLIANCE\"}}],\"Values\":[[{\"Literal\":{\"Value\":\"'Legal'\"}}],[{\"Literal\":{\"Value\":\"'Legal action'\"}}]]}}},{\"DisplayName\":\"Not applicable\",\"Expression\":{\"In\":{\"Expressions\":[{\"Column\":{\"Expression\":{\"SourceRef\":{\"Source\":\"g\"}},\"Property\":\"NON_COMPLIANCE\"}}],\"Values\":[[{\"Literal\":{\"Value\":\"'Not applicable'\"}}],[{\"Literal\":{\"Value\":\"'Not Available'\"}}]]}}}]}"
