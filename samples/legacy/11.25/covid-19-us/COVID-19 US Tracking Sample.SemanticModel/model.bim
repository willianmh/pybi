          {
            "name": "County",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataCategory": "County",
            "dataType": "string",
            "expression": "'COVID'[County Name] & \", \" & 'COVID'[State]",
            "isDataTypeInferred": true,
            "lineageTag": "35e04fd9-50d7-4b81-8c21-8ac5bf177a69",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Daily cases",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "VAR __CountyName = 'COVID'[County Name]",
              "VAR __State = 'COVID'[State]",
              "VAR __Yesterday =  DATEADD(COVID[Date],-1,DAY)",
              "VAR __TodaysCases = 'COVID'[Cases]",
              "",
              "RETURN  __TodaysCases - CALCULATE(",
              "    SUM('COVID'[Cases]) , ",
              "    FILTER(",
              "        COVID, ",
              "        COVID[Date] = __Yesterday &&",
              "        COVID[County Name] = __CountyName &&",
              "        COVID[State] = __State",
              "    )",
              ") + 0"
            ],
            "formatString": "#,0",
            "isDataTypeInferred": true,
            "lineageTag": "3c76fd35-d104-4568-a162-a19dd8b49769",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "Daily deaths",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "VAR __CountyName = 'COVID'[County Name]",
              "VAR __State = 'COVID'[State]",
              "VAR __Yesterday =  DATEADD(COVID[Date],-1,DAY)",
              "VAR __TodaysDeaths = 'COVID'[Deaths]",
              "",
              "RETURN  __TodaysDeaths - CALCULATE(",
              "    SUM('COVID'[Deaths]) , ",
              "    FILTER(",
              "        COVID, ",
              "        COVID[Date] = __Yesterday &&",
              "        COVID[County Name] = __CountyName &&",
              "        COVID[State] = __State",
              "    )",
              ") + 0"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "c1c4daa6-19fb-4cf0-86b0-294c7c800f02",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "StateFIPS",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
